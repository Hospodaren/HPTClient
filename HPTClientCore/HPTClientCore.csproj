<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>HPTrav7</AssemblyName>
    <ProductName>Hjälp på traven 7.0</ProductName>
    <PublisherName>HPT</PublisherName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Icons\HPT.ico</ApplicationIcon>
    <SplashScreen>HPTSplash.png</SplashScreen>
    <StartupObject>HPTClient.App</StartupObject>
    <AssemblyTitle>HPTrav7</AssemblyTitle>
    <SignAssembly>False</SignAssembly>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
